rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    // Admin = existe un documento admins/{uid} (se crea a mano en la consola de Firebase)
    function isAdmin() {
      return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /projects/{project}/tasks/{taskId} {
      allow read: if signed();
      // Alta: solo para la carga inicial de datos (ids con formato "WTG-SISTEMA", ej. 05-1)
      allow create: if signed() && taskId.matches('^[0-9]{1,2}-[0-9]{1,2}$');
      // Un técnico puede cambiar el estado, quién/cuándo lo hizo y la observación (nota de hasta 200 caracteres).
      // Cambiar cualquier otro campo o restaurar datos requiere admin.
      allow update: if signed() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','by','byName','at','note'])
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 200)))
        || isAdmin()
      );
      allow delete: if false;
    }

    // Historial: solo se agrega, nunca se edita ni se borra. El autor debe ser quien escribe.
    match /projects/{project}/history/{entryId} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // Marca de "datos iniciales ya cargados"
    // Acta de avances: solo se agrega. Nadie edita ni borra registros.
    match /projects/{project}/acta/{entryId} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (!('tipo' in request.resource.data) || request.resource.data.tipo in ['acta','dano'])
        && (!('nfotos' in request.resource.data) || (request.resource.data.nfotos is int && request.resource.data.nfotos <= 4))
        && (!('comp' in request.resource.data) || (request.resource.data.comp is string && request.resource.data.comp.size() <= 80))
        && (!('sev' in request.resource.data) || request.resource.data.sev in ['Menor','Mayor','Crítico']);
      // Editar y cerrar casos: se permite cambiar solo estos campos. Cada edición/cierre deja una copia en la subcolección "ediciones".
      // Para cerrar un caso hace falta al menos 1 foto de evidencia y una descripción de lo realizado.
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','wtg','comp','sev','estado','cierreTxt','cierreBy','cierreByName','cierreAt','cierreFotos','editedBy','editedByName','editedAt','editN'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (!('estado' in request.resource.data) || request.resource.data.estado in ['abierto','cerrado'])
        && (request.resource.data.get('estado','abierto') != 'cerrado'
            || (request.resource.data.get('cierreFotos',0) is int
                && request.resource.data.get('cierreFotos',0) >= 1
                && request.resource.data.get('cierreTxt','').size() > 0))
        && (!('cierreFotos' in request.resource.data) || (request.resource.data.cierreFotos is int && request.resource.data.cierreFotos <= 4))
        && (!('comp' in request.resource.data) || (request.resource.data.comp is string && request.resource.data.comp.size() <= 80))
        && (!('sev' in request.resource.data) || request.resource.data.sev in ['Menor','Mayor','Crítico'])
        && (!('wtg' in request.resource.data) || request.resource.data.wtg.size() <= 40);
      allow delete: if false;

      // Historial de ediciones, cierres y reaperturas: solo se agrega.
      match /ediciones/{eid} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.by == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Fotos del acta / daños (comprimidas en el navegador, una por documento). Solo se agregan.
    match /projects/{project}/fotos/{fid} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.actaId is string
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 450000;
      allow update, delete: if false;
    }

    // Piezas extraídas: se agregan; solo se puede cambiar el estado "repuesta". Borrar: solo admin.
    match /projects/{project}/piezas/{pid} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.pieza is string
        && request.resource.data.pieza.size() > 0 && request.resource.data.pieza.size() <= 120
        && request.resource.data.don is int
        && request.resource.data.don >= 1 && request.resource.data.don <= 29
        && request.resource.data.rcv is string
        && request.resource.data.rcv.size() > 0 && request.resource.data.rcv.size() <= 30;
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repuesta','repBy','repByName','repAt']);
      allow delete: if isAdmin();
    }

    // Tareas (sistemas) extra agregadas por los técnicos: ids 23 a 99. Solo se crean.
    match /projects/{project}/sistemas/{sid} {
      allow read: if signed();
      allow create: if signed()
        && sid.matches('^(2[3-9]|[3-9][0-9])$')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;
    }

    // Cortes de grid (evento / programado): cualquier técnico puede registrar, editar y borrar.
    match /projects/{project}/cortes/{cid} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.tipo in ['evento','programado']
        && request.resource.data.ts is int
        && request.resource.data.wtgs is list
        && request.resource.data.wtgs.size() >= 1 && request.resource.data.wtgs.size() <= 29
        && request.resource.data.vuelven is list
        && (!('nota' in request.resource.data) || (request.resource.data.nota is string && request.resource.data.nota.size() <= 300));
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tipo','ts','circ','wtgs','vuelven','def','nota','revisadas','revBy','revByName','revAt','editedBy','editedByName','editedAt'])
        && request.resource.data.tipo in ['evento','programado']
        && request.resource.data.ts is int
        && request.resource.data.wtgs is list
        && request.resource.data.wtgs.size() >= 1 && request.resource.data.wtgs.size() <= 29
        && request.resource.data.vuelven is list
        && (!('nota' in request.resource.data) || (request.resource.data.nota is string && request.resource.data.nota.size() <= 300));
      allow delete: if signed();
    }

    // Chat entre técnicos: cualquiera con sesión lee y escribe; cada uno solo borra sus propios mensajes.
    match /projects/{project}/chat/{mid} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.byName is string
        && request.resource.data.byName.size() > 0 && request.resource.data.byName.size() <= 40
        && request.resource.data.ts is int;
      allow update: if false;
      allow delete: if signed() && resource.data.by == request.auth.uid;
    }

    match /projects/{project}/meta/{doc} {
      allow read: if signed();
      allow create: if signed();
      allow update, delete: if false;
    }

    // Administradores: cada usuario solo puede leer su propio documento; se editan desde la consola
    match /admins/{uid} {
      allow get: if signed() && request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}
