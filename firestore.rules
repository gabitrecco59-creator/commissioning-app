rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    // Admin = existe un documento admins/{uid} (se crea a mano en la consola de Firebase)
    function isAdmin() {
      return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /projects/{project}/tasks/{taskId} {
      allow read: if signed();
      // Alta: solo para la carga inicial de datos (ids con formato "WTG-SISTEMA", ej. 05-1)
      allow create: if signed() && taskId.matches('^[0-9]{1,2}-[0-9]{1,2}$');
      // Un técnico solo puede cambiar el estado y quién/cuándo lo hizo.
      // Cambiar cualquier otro campo (ej. observaciones) o restaurar requiere admin.
      allow update: if signed() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','by','byName','at'])
        || isAdmin()
      );
      allow delete: if false;
    }

    // Historial: solo se agrega, nunca se edita ni se borra. El autor debe ser quien escribe.
    match /projects/{project}/history/{entryId} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // Marca de "datos iniciales ya cargados"
    // Acta de avances: solo se agrega. Nadie edita ni borra registros.
    match /projects/{project}/acta/{entryId} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (!('tipo' in request.resource.data) || request.resource.data.tipo in ['acta','dano'])
        && (!('nfotos' in request.resource.data) || (request.resource.data.nfotos is int && request.resource.data.nfotos <= 4))
        && (!('comp' in request.resource.data) || (request.resource.data.comp is string && request.resource.data.comp.size() <= 80))
        && (!('sev' in request.resource.data) || request.resource.data.sev in ['Menor','Mayor','Crítico']);
      allow update, delete: if false;
    }

    // Fotos del acta / daños (comprimidas en el navegador, una por documento). Solo se agregan.
    match /projects/{project}/fotos/{fid} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.actaId is string
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 450000;
      allow update, delete: if false;
    }

    // Piezas extraídas: se agregan; solo se puede cambiar el estado "repuesta". Borrar: solo admin.
    match /projects/{project}/piezas/{pid} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.pieza is string
        && request.resource.data.pieza.size() > 0 && request.resource.data.pieza.size() <= 120
        && request.resource.data.don is int
        && request.resource.data.don >= 1 && request.resource.data.don <= 29
        && request.resource.data.rcv is string
        && request.resource.data.rcv.size() > 0 && request.resource.data.rcv.size() <= 30;
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repuesta','repBy','repByName','repAt']);
      allow delete: if isAdmin();
    }

    // Tareas (sistemas) extra agregadas por los técnicos: ids 23 a 99. Solo se crean.
    match /projects/{project}/sistemas/{sid} {
      allow read: if signed();
      allow create: if signed()
        && sid.matches('^(2[3-9]|[3-9][0-9])$')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;
    }

    match /projects/{project}/meta/{doc} {
      allow read: if signed();
      allow create: if signed();
      allow update, delete: if false;
    }

    // Administradores: cada usuario solo puede leer su propio documento; se editan desde la consola
    match /admins/{uid} {
      allow get: if signed() && request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}
